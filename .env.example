# LutraGate Server 形态环境变量（复制为 .env 后填写）。
# 生成 ENCRYPTION_KEY：openssl rand -base64 32

# 必填：/admin/* 管理令牌（X-Admin-Token，仅用于引导创建第一个管理员）
ADMIN_TOKEN=change-me-admin-token
# 必填：Key 加密密钥（base64，32 字节）。一旦设定不可更换，否则已存 Key 无法解密。
ENCRYPTION_KEY=

# /v1/* 客户端鉴权使用 lgk_ 访问 key（管理面创建、存于数据库），不再有网关令牌环境变量。

# 可选
# PORT=8787
# DB_PATH=/data/lutragate.db（compose 已固定为数据卷路径）
# ADMIN_IP 白名单（逗号分隔；启用后还需 TRUST_PROXY=1 才能取到真实客户端 IP）
# ALLOWED_IPS=
# TRUST_PROXY=1

# 可选：自签名证书 HTTPS（两个变量必须同时给出；证书 SAN 须覆盖客户端连接的主机名/IP）
# TLS_CERT_PATH=/opt/lutragate/tls/lutragate.crt
# TLS_KEY_PATH=/opt/lutragate/tls/lutragate.key
